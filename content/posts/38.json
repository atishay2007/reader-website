  "content": "<div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><br /><br /><br /><br /><br /><br /><br /><br /><table><tbody><tr><td><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div>स्वदेशी </div><br /><div> </div><br /><div>श्याम  मठपाल </div><br /><div> </div><br /><div>भारत को बचाना है, स्वदेशी को अपनाना है</div><br /><div>अपनी माटी पुकार रही,भारत को उठाना है</div><br /><div> </div><br /><div> </div><br /><div>उद्योग धंधे बंद हैं</div><br /><div>सब फिक्रमंद हैं</div><br /><div>मांग जो आने लगे</div><br /><div>फिर चंद दिन हैं</div><br /><div> </div><br /><div>हमे नहीं घबराना है, भारत को बचाना है</div><br /><div> </div><br /><div>आओ खाएँ हम सपथ</div><br /><div>स्वदेश के लिए है पथ</div><br /><div>स्वदेशी को अपनाकर</div><br /><div>अपनी ही होगी छत</div><br /><div> </div><br /><div>दुनियाँ को दिखाना है,भारत को बचाना है</div><br /><div> </div><br /><div>उपयोग जो भी हो</div><br /><div>उपभोग जो भी हो</div><br /><div>देश में ही बने</div><br /><div>सहयोग जो भी हो</div><br /><div> </div><br /><div>अपना अब जमाना है, भारत को बचाना है</div><br /><div> </div><br /><div>उद्योग व्यापार चलेगा</div><br /><div>सबको रोजगार मिलेगा</div><br /><div>होंगे हम आत्मनिर्भर</div><br /><div>देश का पैसा बचेगा</div><br /><div> </div><br /><div>ये नया तराना है, भारत को बचाना है</div><br /><div> </div><br /><div>मोबाइल या कार हो</div><br /><div>घड़ी या औजार हो</div><br /><div>सब वस्तु यहीं बनें</div><br /><div>अपना कारोबार हो</div><br /><div> </div><br /><div>नहीं हमें घबराना है, भारत को बचाना है</div><br /><div> </div><br /><div>विदेशियों ने हमको लूटा</div><br /><div>गर्दिश में हमसे रूठा</div><br /><div>गुलाम बनाने की साजिश</div><br /><div>अब उनका भरोसा टूटा</div><br /><div> </div><br /><div>सबको ये बतलाना है, भारत को बचाना है</div><br /><div> </div><br /><div>हर हाथ को काम मिले</div><br /><div>हर हुनर को दाम मिले</div><br /><div>बुद्धि-बल में हैं अनुपम</div><br /><div>आत्म-बल का पैगाम मिले</div><br /><div> </div><br /><div>ढूंढना हमें खज़ाना है, भारत को बचाना है</div><br /><div> </div><br /><div>आई ये संकट की घड़ी</div><br /><div>चुनौती ये बहुत बड़ी</div><br /><div>अब जागो देशप्रेमी</div><br /><div>तोड़ दो परतंत्र कड़ी</div><br /><div> </div><br /><div>सबको ही समझाना है, भारत को बचाना है</div><br /><div> </div><br /><div>देश में बना सामान हो</div><br /><div>अपना स्वाभिमान हो</div><br /><div>सुई से लेकर प्लेन तक</div><br /><div>हर दिल में हिंदुस्तान हो</div><br /><div> </div><br /><div>अब न कोई बहाना है, भारत को बचाना है</div><br /><div> </div><br /><div>न खरीदें न बेचेंगे</div><br /><div>भारत की ही सोचेंगे</div><br /><div>परित्याग विदेशी वस्तु का</div><br /><div>इच्छाओं को हम रोकेंगे</div><br /><div> </div><br /><div>नया सपना जगाना है, भारत को बचाना है  ।</div><br /><div> </div><br /><div>श्याम मठपाल, उदयपुर</div><br /></div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /><div><br /><div><br /><div><br /><div><br /><br /><br /><br /><br /><br /><br /><br /><table><tbody><tr><td><img src=\"https://www.google.com/s2/u/0/photos/public/AIbEiAIAAABDCNOHzviK65ayJiILdmNhcmRfcGhvdG8qKGExMGRlZGQyOTU3MGI4ODllYWJmZDUyMDFkZmZjNDFlZTEzYzY3MDYwAUm9-sOFUzlkquKCPRqr6BRbBPS2?sz=80\" /></td><td> </td></tr></tbody></table><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div> </div><br /></div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div> </div><br /><span></span></div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /></div><br /></