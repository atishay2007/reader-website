  "date": "2020-10-28T10:35:02Z",
  "content": "<div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div> </div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div> </div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><br /><br /><br /><br /><br /><br /><br /><br /><table><tbody><tr><td><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div>प्रेम सदा ज़िन्दा रहता है</div><br /><div> </div><br /><div>जीवन भर सपनों में खोया,</div><br /><div>देख बुढ़ापा अंत में रोया।</div><br /><div>चढ़ा जो सूरज ढलता है,</div><br /><div>सन्त सदा ,यही कहता है।</div><br /><div>बस! प्रेम सदा,ज़िंदा रहता है।।</div><br /><div> </div><br /><div>जीवन भर की पाप कमाई,</div><br /><div>अंत समय न  काम आयी।</div><br /><div>साथ नहीं कुछ चलता है,</div><br /><div>सन्त सदा यही कहता है।</div><br /><div>बस! प्रेम सदा,ज़िन्दा रहता है।।</div><br /><div> </div><br /><div>जीवन धारा को मोड़ दो,</div><br /><div>राग-द्वेष को तुम छोड़ दो।</div><br /><div>क्यों ग़फ़लत में  रहता है?</div><br /><div>सन्त सदा,यही कहता है।</div><br /><div>बस!प्रेम सदा ज़िन्दा रहता है।।</div><br /><div> </div><br /><div>नफ़रत को दिल से निकाल,</div><br /><div>वक़्त कम है, वृति सम्भाल।</div><br /><div>क्यों दुःख-सुख  सहता है?</div><br /><div>सन्त  सदा यही कहता है।</div><br /><div>बस ! प्रेम सदा ज़िन्दा रहता है।।</div><br /><div> </div><br /><div>टूट जाते हैं,सुंदर सपनें,</div><br /><div>छूट जाते हैं,प्यारे अपने।</div><br /><div>जड़-चेतन सब मरता है,</div><br /><div>सन्त सदा यही कहता है।</div><br /><div>बस!प्रेम सदा ज़िन्दा रहता है।।</div><br /><div>                         तारा \"प्रीत\"</div><br /><div>                       जोधपुर (राज०)</div><br /></div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /><div><br /><div><br /><div><br /><div><br /><br /><br /><br /><br /><br /><br /><br /><table><tbody><tr><td><img src=\"https://www.google.com/s2/u/0/photos/public/AIbEiAIAAABDCNOHzviK65ayJiILdmNhcmRfcGhvdG8qKGExMGRlZGQyOTU3MGI4ODllYWJmZDUyMDFkZmZjNDFlZTEzYzY3MDYwAUm9-sOFUzlkquKCPRqr6BRbBPS2?sz=80\" /></td><td> </td></tr></tbody></table><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div> </div><br /></div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div> </div><br /><span></span></div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /></div><br /></td><td><br /><div> </div><br /><div><br /><div><br /><div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /></td><td><br /><div> </div><br /><div><br /><div> </div><br /></div><br /><div> </div><br /></td></tr></tbody></table><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /></div><br /></div><br /><div> </div><br /><div><br /><div> </div><br /></div><br /></div><br /></div><br /></div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /></div><br /></div><br /><div> </div><br /><div><b