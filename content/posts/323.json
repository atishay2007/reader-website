  "content": "<div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><br /><br /><br /><br /><br /><br /><br /><br /><table><tbody><tr><td><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div><br /><div>कभी-कभी जिंदगी</div><br /><div> </div><br /><div> </div><br /><div>क्यों कभी-कभी ये </div><br /><div>जिंदगी हैवान सी लगती है</div><br /><div>क्यों कभी-कभी जिंदगी </div><br /><div>परेशान सी लगती है।।</div><br /><div>कभी दवा तो कभी दुआ </div><br /><div>तो कभी हैरान सी लगती है</div><br /><div> </div><br /><div>क्यों कभी-कभी ये </div><br /><div>जिंदगी हैवान सी लगती है।।2।।</div><br /><div> </div><br /><div>ज़ख़मी शायर के शब्दों मे कुछ</div><br /><div> ये जिंदगी पैगाम सी लगती है</div><br /><div>कभी घायल तो कभी मलहम लगा</div><br /><div>ये शब्दों की दुकान सी लगती है।।</div><br /><div> </div><br /><div>क्यों कभी-कभी ये </div><br /><div>जिंदगी हैवान सी लगती है।।2।।</div><br /><div> </div><br /><div>क्यों खुशी के दो पल बाद ही ये जिंदगी</div><br /><div>दर्द-ए जाम की महफ़िल सी सजती है।।</div><br /><div>क्यों फिर हर रात ये जिंदगी काग़ज</div><br /><div>कलम के नाम से ही फबती है।।</div><br /><div> </div><br /><div>क्यों कभी-कभी ये </div><br /><div>जिंदगी हैवान सी लगती है।।2।।</div><br /><div> </div><br /><div>मुस्कुराहट के नाम पे ये जिंदगी</div><br /><div>आंसुओं के सैलाब संग बरसती है</div><br /><div>सुकून,खुशी,मुस्कुराहट के लिये</div><br /><div>अब ये जिंदगी तरसती है।।</div><br /><div> </div><br /><div>क्यों कभी-कभी  ये </div><br /><div>जिंदगी हैवान सी लगती है।।2।।</div><br /><div> </div><br /><div>वीना आडवानी</div><br /><div>नागपुर, महाराष्ट्र</div><br /><div>***************</div><br /><div> </div><br /><div> </div><br /></div><br /><div> </div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /></div><br /><div> </div><br /></div><br /><div>